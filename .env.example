# Copy to .env and fill in.

# Groq API key - https://console.groq.com/keys  (free tier is enough)
GROQ_API_KEY=

# Optional. Leave blank to run on rules only, with no AI calls at all.
# Model options: llama-3.1-8b-instant (cheapest/fastest) | llama-3.3-70b-versatile
GROQ_MODEL=llama-3.1-8b-instant
