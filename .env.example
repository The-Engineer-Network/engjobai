# Copy to .env and fill in.

# Groq API key - https://console.groq.com/keys  (free tier is enough)
GROQ_API_KEY=

# Optional. Leave blank to run on rules only, with no AI calls at all.
# Groq retired the Llama models. Working options (Aug 2026):
#   openai/gpt-oss-20b   fastest and cheapest, correct on this task
#   openai/gpt-oss-120b  stronger, costs more
#   qwen/qwen3.6-27b     also fine
GROQ_MODEL=openai/gpt-oss-20b
